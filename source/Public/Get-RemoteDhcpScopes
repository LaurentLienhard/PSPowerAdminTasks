function Get-RemoteDhcpScopes
{
    <#
    .SYNOPSIS
        Récupère les scopes DHCP, leurs statistiques et les options (Routeur, DNS, etc.) à distance.
    .DESCRIPTION
        Se connecte au serveur via WinRM pour lister les étendues IPv4.
        Pour chaque étendue, récupère :
        - La configuration IP (Plage, Masque)
        - Les statistiques d'utilisation (Libre/Utilisé)
        - Les options principales (3=Routeur, 6=DNS, 15=Domaine)
    #>

    [CmdletBinding()]
    param
    (
        [Parameter(Mandatory = $true, ValueFromPipeline = $true)]
        [string]$ComputerName,

        [Parameter()]
        [PSCredential]$Credential
    )

    process
    {
        Write-Verbose "Connexion au serveur DHCP $ComputerName..."

        $icParams = @{
            ComputerName = $ComputerName
            ErrorAction  = 'Stop'
            ScriptBlock  = {
                # Ce bloc s'exécute SUR le serveur distant

                # 1. Récupérer tous les scopes
                try {
                    $scopes = Get-DhcpServerv4Scope -ErrorAction Stop
                }
                catch {
                    Write-Error "Impossible de lister les scopes. Vérifiez que le rôle DHCP est installé sur $env:COMPUTERNAME."
                    return
                }

                $results = foreach ($scope in $scopes) {

                    # 2. Récupérer les statistiques (IP libres/utilisées)
                    $stats = Get-DhcpServerv4ScopeStatistics -ScopeId $scope.ScopeId

                    # 3. Récupérer les OPTIONS pour ce scope spécifique
                    # On utilise SilentlyContinue car certains scopes n'ont aucune option configurée
                    $allOptions = Get-DhcpServerv4OptionValue -ScopeId $scope.ScopeId -ErrorAction SilentlyContinue

                    # --- Extraction des options standards ---

                    # Option 003 : Routeur (Passerelle)
                    # On utilise -join ', ' au cas où il y aurait plusieurs valeurs
                    $optRouter = ($allOptions | Where-Object { $_.OptionId -eq 3 }).Value -join ', '

                    # Option 006 : Serveurs DNS
                    $optDNS = ($allOptions | Where-Object { $_.OptionId -eq 6 }).Value -join ', '

                    # Option 015 : Nom de domaine DNS
                    $optDomain = ($allOptions | Where-Object { $_.OptionId -eq 15 }).Value -join ', '

                    # Lister les ID des autres options présentes (ex: 44 WINS, 66/67 PXE) pour info
                    $otherOptionsIDs = ($allOptions | Where-Object { $_.OptionId -notin 3,6,15 }).OptionId -join ', '

                    # 4. Construction de l'objet de sortie
                    [PSCustomObject]@{
                        ScopeID         = $scope.ScopeId.IPAddressToString
                        Nom             = $scope.Name
                        Etat            = $scope.State

                        # Configuration IP
                        Masque          = $scope.SubnetMask.IPAddressToString
                        PlageDebut      = $scope.StartRange.IPAddressToString
                        PlageFin        = $scope.EndRange.IPAddressToString

                        # Options DHCP
                        'Routeur'       = if ($optRouter) { $optRouter } else { "N/A" }
                        'DNS'           = if ($optDNS) { $optDNS } else { "N/A" }
                        'Domaine'       = if ($optDomain) { $optDomain } else { "N/A" }
                        'AutresOptIDs'  = if ($otherOptionsIDs) { $otherOptionsIDs } else { "-" }

                        # Statistiques
                        Utilise         = $stats.InUse
                        Libre           = $stats.Free
                        Pourcent        = "{0:N0}%" -f $stats.PercentageInUse
                    }
                }
                return $results
            }
        }

        # Ajout du credential si fourni
        if ($Credential) {
            $icParams.Add('Credential', $Credential)
        }

        try
        {
            # Lancement de la commande
            $data = Invoke-Command @icParams

            # Affichage propre (suppression des propriétés techniques WinRM)
            if ($data) {
                $data | Select-Object * -ExcludeProperty PSComputerName, RunspaceId, PSShowComputerName
            }
            else {
                Write-Warning "Aucune donnée retournée par $ComputerName."
            }
        }
        catch
        {
            Write-Error "Erreur de connexion à $ComputerName : $($_.Exception.Message)"
        }
    }
}
